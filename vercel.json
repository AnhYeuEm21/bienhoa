{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/chua_soc_lon.html" },
    { "source": "/soclon", "destination": "/chua_soc_lon.html" },
    { "source": "/bienhoa", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets_soclon/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
